<Window x:Class="AutomacaoPromobTeste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automação Promob - Central de Controle" 
        Height="700" 
        Width="1050"
        MinWidth="900"
        MinHeight="600"
        Background="#0F1016"
        WindowStartupLocation="CenterScreen"
        Foreground="#E2E8F0">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D303E"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER SECTION ================= -->
        <Border Grid.Row="0" Background="#181A25" CornerRadius="10" Padding="20,15" Margin="0,0,0,20" BorderBrush="#262A3B" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="AUTOMAÇÃO PROMOB" FontSize="20" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                    <TextBlock Text="Central de Controle &amp; Monitoramento Contínuo de Projetos 3D" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Indicator light -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="statusIndicator" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="txtStatusText" Text="Parado" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT SECTION ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left panel (Stats and buttons) -->
                <ColumnDefinition Width="400"/>
                <!-- Splitter / spacing -->
                <ColumnDefinition Width="20"/>
                <!-- Right panel (Logs Console) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTAINER -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Operations Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spacing -->
                    <RowDefinition Height="20"/>
                    <!-- Statistics Card -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. OPERATIONS CARD -->
                <Border Grid.Row="0" Background="#181A25" CornerRadius="10" BorderBrush="#262A3B" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Ações de Controle" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,15"/>
                        
                        <!-- Toggle Automacao Button (Iniciar/Parar) -->
                        <Button x:Name="btnToggleAutomacao" 
                                Content="Iniciar Automação" 
                                Style="{StaticResource ModernButton}" 
                                Background="#10B981" 
                                Height="45" 
                                Margin="0,0,0,12" 
                                IsEnabled="False"
                                Click="BtnToggleAutomacao_Click"/>

                        <!-- Open Promob Button -->
                        <Button x:Name="btnAbrirPromob" 
                                Content="Abrir Promob" 
                                Style="{StaticResource ModernButton}" 
                                Background="#3B82F6" 
                                Height="45" 
                                Click="BtnAbrirPromob_Click"/>
                    </StackPanel>
                </Border>

                <!-- 2. METRICS CARD -->
                <Border Grid.Row="2" Background="#181A25" CornerRadius="10" BorderBrush="#262A3B" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Resultados Processamento" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,15"/>

                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                            <!-- Success Metric Card -->
                            <Border Background="#1E293B" CornerRadius="8" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,8,0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sucessos" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtSucessosCount" Text="0" FontSize="36" FontWeight="Black" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Error Metric Card -->
                            <Border Background="#1E293B" CornerRadius="8" BorderBrush="#EF4444" BorderThickness="1" Margin="8,0,0,0" Padding="15">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Erros" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtErrosCount" Text="0" FontSize="36" FontWeight="Black" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Extra details panel -->
                        <Border Grid.Row="2" Background="#13151F" CornerRadius="8" Padding="12" BorderBrush="#1F2231" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Pasta Monitorada:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtPastaMonitorada" Text="Área de Trabalho\promob" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Destino XML:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtPastaXml" Text="Área de Trabalho\xml" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT CONTAINER (LOG CONSOLE) -->
            <Border Grid.Column="2" Background="#181A25" CornerRadius="10" BorderBrush="#262A3B" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Log Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Log Text Area -->
                        <RowDefinition Height="*"/>
                        <!-- Clear Button -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Console de Registro (Logs)" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <TextBlock Text="Monitored Output" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0A0B10" CornerRadius="8" BorderBrush="#1E202E" BorderThickness="1" Padding="5">
                        <TextBox x:Name="txtLogTerminal" 
                                 FontFamily="Consolas, Courier New, monospace" 
                                 FontSize="12" 
                                 Background="Transparent" 
                                 Foreground="#E2E8F0" 
                                 BorderThickness="0" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Disabled"
                                 AcceptsReturn="True"/>
                    </Border>

                    <Button Grid.Row="2" 
                            x:Name="btnClearLog" 
                            Content="Limpar Console" 
                            Style="{StaticResource ModernButton}" 
                            Background="#334155" 
                            Height="32" 
                            FontSize="12"
                            Padding="12,4" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,0,0" 
                            Click="BtnClearLog_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
